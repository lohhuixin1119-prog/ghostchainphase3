### 4. (Optional) `test_phase3.py` – basic smoke test

```python
import requests
import json

BASE = "http://localhost:8080"

def test_health():
    r = requests.get(f"{BASE}/ghost-chains/health")
    assert r.status_code == 200
    assert r.json() == {"status": "ok"}

def test_reset():
    r = requests.post(f"{BASE}/ghost-chains/reset", json={"clearTransactions": True})
    assert r.status_code == 200
    assert r.json() == {"clearTransactions": True}

def test_transactions():
    payload = {
        "transactions": [
            {
                "txId": "tx1",
                "fromUserId": "meridian",
                "toUserId": "apex",
                "amount": 10000,
                "createdAt": "2026-06-08T12:00:00Z"
            }
        ]
    }
    r = requests.post(f"{BASE}/ghost-chains/transactions", json=payload)
    assert r.status_code == 200
    data = r.json()
    assert len(data["transactions"]) == 1
    assert data["transactions"][0]["txId"] == "tx1"
    assert 0.0 <= data["transactions"][0]["riskScore"] <= 1.0

if __name__ == "__main__":
    test_health()
    test_reset()
    test_transactions()
    print("All tests passed.")
